{
  "name": "cbz-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/prerender/entry-server.ts --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "vue-tsc --noEmit",
    "samples": "node scripts/make-samples.mjs",
    "samples:demo": "node scripts/make-samples.mjs --demo",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:offline": "node test/offline.mjs",
    "test:convert": "node test/convert.mjs"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.7.62",
    "idb-keyval": "^6.2.1",
    "pdf-lib": "^1.17.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "^3.5.13",
    "puppeteer-core": "^25.17.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  }
}
